    },
    "partOfSpeech": [
      "noun"
    ],
    "definitions": {
      "noun": "Used loosely, a tentative conjecture explaining an observation, phenomenon or scientific problem that can be tested by further observation, investigation and/or experimentation. As a scientific term of art, see the attached quotation. Compare to theory, and quotation given there."
    },
    "vietnamese": {
      "noun": "Được sử dụng một cách lỏng lẻo, một phỏng đoán dự kiến giải thích một quan sát, hiện tượng hoặc vấn đề khoa học có thể được kiểm tra bằng cách quan sát, điều tra và/hoặc thử nghiệm thêm. Là một thuật ngữ khoa học của nghệ thuật, xem báo giá đính kèm. So sánh với lý thuyết và trích dẫn được đưa ra ở đó."
    },
    "synonyms": [
      "educated guess",
      "guess",
      "supposition",
      "theory",
      "thesis",
      "surmise",
      "conjecture",
      "speculation"
    ],
    "antonyms": [],
